# Impostazioni della mappa tattica. Copia questo file in .env e compila i valori (.env non va mai condiviso).
# Sono le stesse della mappa di prima: il file .env che c'è già sul server va bene così com'è.

# App Discord per il login (https://discord.com/developers/applications)
CLIENT_ID=
CLIENT_SECRET=
CALLBACK_URL=https://mappatattica.lse.sc/auth/discord/callback

# Server Discord LSE e ruoli che danno i permessi nella mappa
GUILD_ID=
CREATOR_USER_ID=
ADMIN_ROLE_ID=
RESPONSABILE_ROLE_ID=
PLSE_ROLE_ID=

# Chiave per firmare le sessioni (stringa casuale lunga)
SESSION_SECRET=

# Porta su cui ascolta il server (predefinita 3000)
PORT=

# Accesso dal sito LSE (Area membri → Strumenti): la mappa si apre dentro il sito e chi è entrato nel sito
# entra anche qui. Servono tutte e due; senza, la mappa funziona lo stesso (solo login con Discord).
# LSE_SEGRETO: la stessa stringa di MAPPA_TATTICA_SEGRETO nel .env.local del sito.
LSE_SEGRETO=
# Indirizzi del sito LSE che possono mostrare la mappa, separati da virgola (es. https://lse.sc)
LSE_SITO_URL=
